local localeExact={} for _,r in localeRows do localeExact[r[1]]=r end
local localized=setmetatable({},{__mode="k"})
local function translate(source)
 local index=language=="en" and 3 or 2
 local exact=localeExact[source] if exact then return exact[index] or source end
 -- Match only the original string, never translated output (avoids cascading substitutions).
 local out={} local cursor=1
 while cursor<=#source do
 local first,last,row
 for _,r in localeRows do
 if r[index] then
 local a,b=string.find(source,r[1],cursor,true)
 if a and (r[1]=="ON" or r[1]=="OFF") and (string.sub(source,a-1,a-1):match("[%w_]") or string.sub(source,b+1,b+1):match("[%w_]")) then a=nil end
 if a and (not first or a<first or (a==first and b>last)) then first,last,row=a,b,r end
 end
 end
 if not first then table.insert(out,string.sub(source,cursor)) break end
 table.insert(out,string.sub(source,cursor,first-1)) table.insert(out,row[index]) cursor=last+1
 end
 return table.concat(out)
end
