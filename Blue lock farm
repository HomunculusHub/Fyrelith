do
 local originals=setmetatable({},{__mode="k"})
 local active=false
 S.fpsBoost={active=false,changed=0}
 local function simplify(object)
  if not active or not object:IsDescendantOf(workspace) or originals[object] then return end
  local values
  if object:IsA("Decal") or object:IsA("Texture") then values={Transparency=object.Transparency}
  elseif object:IsA("MeshPart") then values={TextureID=object.TextureID,Material=object.Material}
  elseif object:IsA("SpecialMesh") then values={TextureId=object.TextureId}
  elseif object:IsA("BasePart") then values={Material=object.Material} end
  if not values then return end
  originals[object]=values
  for property in values do
   pcall(function()object[property]=property=="Transparency" and 1 or property=="Material" and Enum.Material.SmoothPlastic or "" end)
  end
  S.fpsBoost.changed+=1
 end
 S.restoreFPSTextures=function()
  active=false S.fpsBoost.active=false
  for object,values in originals do
   for property,value in values do pcall(function()object[property]=value end) end
   originals[object]=nil
  end
  S.fpsBoost.changed=0
 end
 table.insert(connections,workspace.DescendantAdded:Connect(function(object)
  if active then task.defer(function()simplify(object)end) end
 end))
