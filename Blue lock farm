 else for k,v in value do if type(k)=="string" and type(v)=="boolean" then map[k]=v end end end
 options[key]=map
 elseif kind=="boolean" and type(value)=="boolean" or kind=="string" and type(value)=="string" or kind=="number" and validNumber(value) then options[key]=value end
