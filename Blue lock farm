-- Auto Rewards: Index, Playtime, Daily Login and Offline Earnings.
do
local env=getgenv()
if env.BlueFarmRewards then
 env.BlueFarmRewards.running=false
 if env.BlueFarmRewards.connections then
 for _,c in env.BlueFarmRewards.connections do c:Disconnect() end
 end
end
local state={running=true,claimed=0,indexTokens=0,dailyClaims=0,offlineCash=0,connections={},status="Checking rewards"}
env.BlueFarmRewards=state
local rs=game:GetService("ReplicatedStorage")
local p=game.Players.LocalPlayer
local remotes=rs.Remotes
local data=require(rs.Client.Data.ClientDataManager)
local play=require(rs.Shared.Services.PlaytimeRewardsService)
local rewards=require(rs.Shared.Core.Storage.Game.PlaytimeRewardsLibrary)
local index=require(rs.Shared.Services.IndexRewardsService)
local daily=require(rs.Shared.Services.DailyLoginService)
local nextTry={}
local offlinePending=true
table.insert(state.connections,remotes.ShowOfflineEarnings.OnClientEvent:Connect(function(payload)
 if state.running and type(payload)=="table" and (payload.Cash or 0)>0 then offlinePending=true end
end))
table.insert(state.connections,remotes.OfflineEarningsClaimed.OnClientEvent:Connect(function(amount)
 if state.running then
 state.offlineCash+=tonumber(amount) or 0
 state.status="Offline earnings confirmed"
 end
end))
local function due(name,delay)
 local now=os.clock()
 if now<(nextTry[name] or 0) then return false end
 nextTry[name]=now+delay
 return true
end
local function owned(reward)
 local d=data.GetData()
 if reward.Type=="Box" then
 local variants=d.Inventory.Boxes[reward.BoxName]
 local entry=variants and variants[reward.VariantName or "Normal"]
 return entry and entry.Amount or 0
 elseif reward.Type=="Item" then
 return tonumber(d.Tokens[reward.ItemName]) or tonumber(d.Potions[reward.ItemName]) or 0
 end
 return nil
end
local function waitFor(predicate)
 local deadline=os.clock()+1.5
 repeat task.wait(0.05) until not state.running or predicate() or os.clock()>=deadline
 return predicate()
end
task.spawn(function()
 while state.running and S.running and gui.Parent do
 local farm=env.BlueFarm
 if X.rewards and farm and farm.running and farm.enabled then
 local ok,err=pcall(function()
 if offlinePending and due("offline",5) then
 offlinePending=false
 remotes.ClaimOfflineEarnings:FireServer()
 end
 if index.HasAnyClaimable() and due("index",15) then
 local token=index.GetRewardTokenName()
 local before=data.GetData().Tokens[token] or 0
 remotes.ClaimAllIndexRewards:FireServer()
 if waitFor(function()return (data.GetData().Tokens[token] or 0)>before end) then
 local gained=(data.GetData().Tokens[token] or 0)-before
 state.indexTokens+=gained
 state.status="Index rewards confirmed: +"..gained.." "..token
 end
 end
 if daily.CanClaim(p) and due("daily",30) then
 local before=data.GetData().DailyRewards.DayIndex or 0
 remotes.ClaimDailyReward:FireServer()
 if waitFor(function() return (data.GetData().DailyRewards.DayIndex or 0)>before end) then
 state.dailyClaims+=1 state.status="Daily login confirmed"
 end
 end
 for i,entry in rewards.Rewards do
 if not state.running then break end
 if play.CanClaim(p,i) and due("play:"..i,30) then
 local reward=entry.Rewards[1]
 local before=owned(reward)
 if before~=nil then
 remotes.ClaimPlaytimeReward:FireServer(i)
 if waitFor(function()return (owned(reward) or 0)>before end) then
 play.MarkClaimed(p,i)
 state.claimed+=1
 state.status="Playtime reward "..i.." confirmed"
 end
 end
 end
 end
 state.dailyWait=daily.GetTimeUntilNextClaim(p)
 end)
 if not ok then
 local message=tostring(err) if state.lastError~=message then S.errors+=1 end
 state.lastError=message state.status="ERROR: "..message S.lastError="Rewards: "..message
 end
 end
 task.wait(0.25)
 end
 for _,c in state.connections do c:Disconnect() end
end)
end

-- Fast locker opening: respect server timers, skip the local reveal animation.
do
local env=getgenv()
if env.BlueFarmInstant then env.BlueFarmInstant.running=false end
local state={running=true,opened=0,errors=0,skipAnimation=true,status="Waiting for server-ready lockers"}
env.BlueFarmInstant=state
local rs=game:GetService("ReplicatedStorage")
local player=game.Players.LocalPlayer
local collection=game:GetService("CollectionService")
local boxService=require(rs.Shared.Services.BoxService)
local handlerClass=require(rs.Client.Core.Classes.DropperBoxHandler)
env.BlueFarmOriginalPlacement=env.BlueFarmOriginalPlacement or handlerClass._initAnimation
handlerClass._initAnimation=function(self,...)
 local current=env.BlueFarmInstant
 if current and current.running and current.skipAnimation and S.running and S.enabled and X.fastOpen then
 if self.BoxModel then
 self.BoxModel:ScaleTo(1)
 self.BoxModel:PivotTo(self.Attachments.Top.WorldCFrame)
 end
 return false
 end
 return env.BlueFarmOriginalPlacement(self,...)
end
env.BlueFarmOriginalReveal=env.BlueFarmOriginalReveal or handlerClass._playOpenAnimation
handlerClass._playOpenAnimation=function(self,...)
 local current=env.BlueFarmInstant
 if current and current.running and current.skipAnimation and S.running and S.enabled and X.fastOpen then
 self.Maid.OpenLocker=nil
 self.Maid.OpenCharacter=nil
 self:_finishOpenAnimation()
 else return env.BlueFarmOriginalReveal(self,...) end
end
task.spawn(function()
 local cache={}
 local refreshed=0
 local inFlight=setmetatable({},{__mode="k"})
 while state.running and S.running and gui.Parent do
 local farm=env.BlueFarm
 if X.fastOpen and farm and farm.running and farm.enabled then
 local ok,err=pcall(function()
 local plot=workspace.Map.PlotModels:FindFirstChild(player.Name)
 if not plot then return end
 if os.clock()-refreshed>=1 then
 refreshed=os.clock()
 cache={}
 for _,handler in filtergc("table",{Keys={"Part","Attachments","Callbacks"}},false) do
 if typeof(handler.Part)=="Instance" and handler.Part:IsDescendantOf(plot) and type(handler.OpenBox)=="function" and not handler._destroyed then
 cache[handler.Part]=handler
 end end
 end
 for part,handler in cache do
 if part.Parent and part:GetAttribute("Type")=="Box" and not handler._destroyed and not handler._opening and not inFlight[handler] then
 if boxService.IsBoxReady(part:GetAttribute("BoxName"),part:GetAttribute("PlacedAt"),part:GetAttribute("Variant")) then
 inFlight[handler]=true
 task.spawn(function()
 local success,openError=pcall(function() handler:OpenBox() end)
 if success then
 if part:GetAttribute("Type")~="Box" then state.opened+=1 S.opened+=1 state.status="Opened ready locker without reveal animation" end
 else state.errors+=1 state.lastError=tostring(openError) end
 inFlight[handler]=nil
 end)
 end end
 end
 end)
 if not ok then state.errors+=1 state.lastError=tostring(err) end
 end
 task.wait(0.05)
 end
end)
end


