local function ready(key,seconds)
 local now=os.clock() if now<(cooldown[key] or 0) then return false end cooldown[key]=now+seconds return true
end
local function alive() return S.running and gui.Parent~=nil end
local function waitFor(predicate,seconds)
 local finish=os.clock()+(seconds or 2)
 repeat if predicate() then return true end task.wait(0.05) until not alive() or os.clock()>=finish
 return predicate()
end
local function cashAllowed(price)
 local cash=D.GetData().Currency.Cash or 0
 if type(price)~="number" or price~=price or price<0 or price==math.huge or price>cash then return false end
 if X.fullMarketBalance then return true end
 return price<=cash*X.spendPercent/100 and cash-price>=X.reserveCash
end
local function ownedBox(name,variant)
 local b=D.GetData().Inventory.Boxes[name] local e=b and b[variant] return e and e.Amount or 0
end
