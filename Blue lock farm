-- A missing raycast never becomes a destination. Sample the footprint as well
-- as its centre so a tiny prop or an edge cannot be mistaken for a floor.
local function safeStanding(pos,character,human,root,ignore)
 if typeof(pos)~="Vector3" or pos.X~=pos.X or pos.Y~=pos.Y or pos.Z~=pos.Z or pos.Magnitude>1e6 then return nil end
 local height=human.RigType==Enum.HumanoidRigType.R6 and 3 or math.max(2.5,human.HipHeight+root.Size.Y/2)
 local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude
 params.FilterDescendantsInstances=ignore and {character,ignore} or {character} params.RespectCanCollide=true
 local centre=workspace:Raycast(pos+Vector3.new(0,1,0),Vector3.new(0,-height-5,0),params)
 if not centre or centre.Normal.Y<0.7 or centre.Position.Y>pos.Y+0.5 or pos.Y-centre.Position.Y>height+3 then return nil end
 if centre.Instance:IsA("BasePart") and not centre.Instance.Anchored then return nil end
 for _,offset in {Vector3.new(1,0,0),Vector3.new(-1,0,0),Vector3.new(0,0,1),Vector3.new(0,0,-1)} do
 local hit=workspace:Raycast(centre.Position+offset+Vector3.new(0,1,0),Vector3.new(0,-2,0),params)
 if not hit or hit.Normal.Y<0.7 or math.abs(hit.Position.Y-centre.Position.Y)>0.65 then return nil end
 end
 local destination=centre.Position+Vector3.new(0,height+0.15,0)
 -- Reject standing inside collidable geometry (e.g. a shop podium).
 -- Mesh bounding boxes can span the entire stadium; use actual collision rays.
 for _,offset in {Vector3.zero,Vector3.new(0.8,0,0),Vector3.new(-0.8,0,0),Vector3.new(0,0,0.8),Vector3.new(0,0,-0.8)} do
 if workspace:Raycast(centre.Position+offset+Vector3.new(0,0.2,0),Vector3.new(0,height+2,0),params) then return nil end
 end
 return destination
end
