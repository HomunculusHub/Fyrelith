-- Debounced auto-save with stable fingerprints and a last-good backup.
do
local lastFingerprint local lastGoodRaw
local function copySettings()
 local options={}
 for key,kind in optionKinds do
 local value=X[key]
 if kind=="table" and type(value)=="table" then
 local map={}
 if key=="towerTeam" then for slot=1,require(RS.Shared.Constants).InfinityTowerUnitSlots do if type(value[slot])=="string" then map[tostring(slot)]=value[slot] end end
 else for k,v in value do if type(k)=="string" and type(v)=="boolean" then map[k]=v end end end
 options[key]=map
 elseif kind=="boolean" and type(value)=="boolean" or kind=="string" and type(value)=="string" or kind=="number" and validNumber(value) then options[key]=value end
 end
 local conveyor={}
 for _,key in {"autoBuy","spawnBestLocker","warnings","variantFilter","autoSellLockers"} do conveyor[key]=config[key] end
 conveyor.variants=table.clone(config.variants) conveyor.boxes=table.clone(config.boxes)
 return {schema=1,placeId=game.PlaceId,userId=P.UserId,deviceId=S.device.id,enabled=S.enabled,language=G.BlueFarmLanguage or "th",options=options,conveyor=conveyor,ui={x=panel.Position.X.Offset,y=panel.Position.Y.Offset,minimized=minimized}}
end
local function canonical(value)
 if type(value)~="table" then return http:JSONEncode(value) end
 local keys={} for key in value do table.insert(keys,key) end table.sort(keys,function(a,b)return tostring(a)<tostring(b)end)
 local rows={} for _,key in keys do table.insert(rows,http:JSONEncode(tostring(key))..":"..canonical(value[key])) end
 return "{"..table.concat(rows,",").."}"
end
S.saveConfig=function()
 if G.BlueFarm~=S then return false end
 local ok,result=pcall(function()
 local snapshot=copySettings()
 local fingerprint=canonical(snapshot)
 if fingerprint==lastFingerprint then return true end
 G.BlueFarmConfigSessions[configPath]=snapshot
 if type(writefile)~="function" then
 lastFingerprint=fingerprint configState.status="Config: session only" return true
 end
 local raw=http:JSONEncode(snapshot)
 -- Retain the previous valid content before updating the primary file.
 if not lastGoodRaw and type(readfile)=="function" then
 local readOK,previous=pcall(readfile,configPath)
 if readOK and type(previous)=="string" and #previous<250000 then
 local parseOK,parsed=pcall(function()return http:JSONDecode(previous)end)
 if parseOK and validEnvelope(parsed) then lastGoodRaw=previous end
 end
 end
 if lastGoodRaw then pcall(writefile,configPath..".bak",lastGoodRaw) end
 writefile(configPath,raw)
 lastGoodRaw=raw lastFingerprint=fingerprint configState.saves+=1 configState.lastError="" configState.status="Config: saved"
 return true
 end)
 if not ok then configState.lastError=tostring(result) configState.status="Config: save failed" return false end
 return result
end
