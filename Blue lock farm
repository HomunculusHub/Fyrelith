local function canonical(value)
 if type(value)~="table" then return http:JSONEncode(value) end
 local keys={} for key in value do table.insert(keys,key) end table.sort(keys,function(a,b)return tostring(a)<tostring(b)end)
 local rows={} for _,key in keys do table.insert(rows,http:JSONEncode(tostring(key))..":"..canonical(value[key])) end
 return "{"..table.concat(rows,",").."}"
end
